                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "<state>/swarm-helpers.json",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
