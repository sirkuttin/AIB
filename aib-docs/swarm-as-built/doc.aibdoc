        },
        {
          "id": "2571760180.50731",
          "type": "heading",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null,
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Appendix for builders: choices made",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50732",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Internal notes for builders. The design above already applies all of these; nothing here needs the owner.",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50733",
          "type": "heading",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null,
            "level": 4
          },
          "content": [
            {
              "type": "text",
              "text": "Numbers and rules",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50734",
          "type": "bulletList",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "content": [
            {
              "id": "2571760180.75941",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.75942",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Caps: 3 helpers at once (reviewers count), depth 1, 6 starts per 10 min. Budget: 120 helper-minutes + $10 reported cost per project per day (local midnight), amber at 80%, +60 min per tap; no start on an account above 90% of its window. Budget counts time because every provider has it; cost and quota are added where reported.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.76273",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.76274",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Rules: search → Gemini CLI Flash; tests/bulk → Codex; UI/copy → Claude Sonnet; hard debugging/design → Claude Opus; review → a different provider; else → Codex. Missing providers skipped. Override needs ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "why",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", shown amber.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.76504",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.76505",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Brief required: goal, owns, done_when, reply_with, test_cmd. Worktree ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "aib/helper-<slug>",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " from main's tip. Helpers in edit-inside-workspace mode.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.76658",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.76659",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Reports: steer if busy, next prompt if idle; wrapped; clipped at 4,000 chars; AIB computes diff and test facts. Status throttle 60 s.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.76796",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.76797",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Merge: main into helper, run test_cmd, land; one at a time. Big or risky = >300 lines, auth/payments/migrations/CI/build/lockfiles, or deletions; needs a review or a stated reason. Undo = revert commits for the recorded range.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.77027",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.77028",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Main chat's own limit: one-click Continue with another agent, never automatic (your conversation keeps its agent unless you switch). No automatic switch back after a hand-off.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.77207",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.77208",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Stuck = 10 min with no progress or the same tool call 5x. Crash: restart once, then next provider. Composer Stop = main turn only; Stop helpers = all; stopping commits first.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.77386",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.77387",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Push: needs you, failed, paused. Done is quiet. The strip is shown only if a helper ran today. Best of N: at most 3, only from the user's ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "/best-of",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ".",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50735",
          "type": "heading",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null,
            "level": 4
          },
          "content": [
            {
              "type": "text",
              "text": "Additions (owner didn't ask; each can be dropped alone)",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50736",
          "type": "bulletList",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "content": [
            {
              "id": "2571760180.77603",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.77604",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Sidebar nesting; rule edits by chat with an Undo line; \"Switch back\" link; merge line, Undo and Add-time on the phone; 7-day cleanup of unmerged worktrees; ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "AIB_HELPER_PORT",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "; per-project \"never send to\"; start-churn limit; ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "state/swarm-log.jsonl",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "; native subagents under helpers (phase 4).",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.50737",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Sources: ",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
