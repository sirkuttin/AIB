              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30418",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Caps and budget: an honest meter",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30454",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30455",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Limit hand-off: work keeps going",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30491",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30492",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Review by another provider: a second pair of eyes",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30545",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30546",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Merge lines: one line, one Undo",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30581",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30582",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Inbox and phone: helpers reach you anywhere",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30629",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30630",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Stop: end one helper or all, keep the work",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
