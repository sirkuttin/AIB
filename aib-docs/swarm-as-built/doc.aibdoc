        },
        {
          "id": "2571760180.238",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "The rule (review option C):",
              "marks": [
                {
                  "type": "bold"
                },
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " a chat is a helper only if the helper registry lists it. Every other open chat that works in its own worktree is a main chat. A chat that works in the project folder itself (no git, or worktrees not possible) is neither, and gets no swarm tools.",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
