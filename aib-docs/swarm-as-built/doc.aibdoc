          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Each report also posts a \"Report from…\" line, and a delivered report marks the main chat handled in the inbox.",
