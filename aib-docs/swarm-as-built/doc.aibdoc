                          ]
                        }
                      ]
                    },
                    {
                      "id": "2571760180.31613",
                      "type": "listItem",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "content": [
                        {
                          "id": "2571760180.31614",
                          "type": "paragraph",
                          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                          "attrs": {
                            "align": null
                          },
                          "content": [
                            {
                              "type": "text",
                              "text": "Helper: Gemini CLI",
                              "marks": [
                                {
                                  "type": "bold"
                                },
                                {
                                  "type": "agentEdit",
                                  "attrs": {
                                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                                  }
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": ": own chat, own worktree, read-only search job",
                              "marks": [
                                {
                                  "type": "agentEdit",
                                  "attrs": {
                                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "2571760180.31686",
                      "type": "listItem",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "content": [
                        {
                          "id": "2571760180.31687",
                          "type": "paragraph",
                          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                          "attrs": {
                            "align": null
                          },
                          "content": [
                            {
                              "type": "text",
                              "text": "Reviewer: Claude Code",
                              "marks": [
                                {
                                  "type": "bold"
                                },
                                {
                                  "type": "agentEdit",
                                  "attrs": {
                                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                                  }
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": ": reads one helper's diff only, writes nothing",
                              "marks": [
                                {
                                  "type": "agentEdit",
                                  "attrs": {
                                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.31762",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.31763",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "→ ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "Report → merge",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Each helper's report lands in the main chat on its own. The main agent merges it into main: one line with Undo.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.31902",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.31903",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "One writer per worktree.",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The main agent writes to main. Each helper writes only to its own worktree. Reviewers write nothing.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.32036",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.32037",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Agents as tools, not handoffs.",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The main agent keeps ownership: it gets each answer back and decides what lands.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.32156",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.32157",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Helpers never see the main chat.",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " They get a written brief with required fields (section 4), plus the project's shared notes (",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "AGENTS.md",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " / ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "CLAUDE.md",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ").",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.28141",
          "type": "heading",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null,
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "2. What AIB already has (from the code)",
