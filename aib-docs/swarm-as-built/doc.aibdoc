        {
          "id": "2571760180.28142",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Checked in ",
