                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "{version: 1, helpers: {<id>: Helper}}",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " (",
                          "marks": [
                            {
