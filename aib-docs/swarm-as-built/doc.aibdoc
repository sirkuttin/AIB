                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "→ ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "Main agent",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Your chosen agent (for example Claude Code). Edits ",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "main",
                      "marks": [
                        {
                          "type": "code"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " directly. Has AIB's swarm tools. Owns every merge.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
