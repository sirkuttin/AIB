        },
        {
          "id": "2571760180.28137",
          "type": "heading",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null,
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "1. How it works: one chat, many providers, one main",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.28138",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Cross-agent and local: every helper runs that vendor's official app with your own login on your computer, and AIB connects to it over ACP like any other chat. Nothing goes through an AIB server.",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.28139",
          "type": "paragraph",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "attrs": {
            "align": null
          },
          "content": [
            {
              "type": "text",
              "text": "Flow (diagram):",
              "marks": [
                {
                  "type": "agentEdit",
                  "attrs": {
                    "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "2571760180.28140",
          "type": "bulletList",
          "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
          "content": [
            {
              "id": "2571760180.31276",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.31277",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "You",
                      "marks": [
                        {
                          "type": "bold"
                        },
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Type in one chat. Answer approvals in the chat, the inbox or on your phone.",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
