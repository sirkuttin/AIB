                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "How AIB enforces it (server side)",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62055",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62056",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62057",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Only the main agent starts helpers",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62097",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62098",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Swarm tools are offered only with ",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "STUDIO_MAIN=1",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ". The route also checks the caller's per-conversation key against the helper registry and refuses any key that belongs to a helper or reviewer.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62300",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62301",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62302",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "No nesting",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62318",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62319",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Same check; depth is always 1. A helper's own internal subagents (Claude's Agent tool) still run inside that helper and count toward its time.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62467",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62468",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62469",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "At most 3 at once",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62492",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62493",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Counted from AIB's helper registry (live connections), never from what the agent says. Reviewers count.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62602",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62603",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62604",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Daily budget",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62622",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62623",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "AIB adds up helper working time (turn start to turn end) and reported cost from ",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "usage_update",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ". At the cap it cancels turns, commits worktrees, sets Paused, and refuses new starts.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62813",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62814",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62815",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Account floor",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62834",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62835",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Refuses to start on an account above 90% (limits feed) and takes the rule's next provider.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.62931",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.62932",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62933",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Start churn",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.62950",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.62951",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "At most 6 starts per 10 minutes per main chat. [Addition]",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.63014",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.63015",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63016",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Brief contract",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.63036",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63037",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Required fields checked; ",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "owns",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " globs checked against running helpers.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.63117",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.63118",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63119",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Approvals from the user only",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.63153",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63154",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "No swarm tool answers a permission request. Helper permission requests go to the page, inbox and phone through the session-authenticated routes only, never through the agent's key (closes the old HIGH-1). ",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "message_helper",
                          "marks": [
                            {
                              "type": "code"
                            },
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " text is labelled and never counts as consent.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.63431",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.63432",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63433",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Caps only raised by the user",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "2571760180.63467",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63468",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "No tool changes caps. Only Settings, the note buttons or the phone action can.",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.63552",
              "type": "tableRow",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.63553",
                  "type": "tableCell",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null,
                    "colspan": 1,
                    "colwidth": null,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "id": "2571760180.63554",
                      "type": "paragraph",
                      "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                      "attrs": {
                        "align": null
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Review for big or risky diffs",
                          "marks": [
                            {
                              "type": "agentEdit",
                              "attrs": {
                                "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
