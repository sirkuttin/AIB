                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Failure modes: stuck, conflicts, provider down",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30727",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30728",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Privacy and terms: local, your own logins",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "2571760180.30773",
              "type": "listItem",
              "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
              "content": [
                {
                  "id": "2571760180.30774",
                  "type": "paragraph",
                  "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e",
                  "attrs": {
                    "align": null
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Agent side: the main agent's tools",
                      "marks": [
                        {
                          "type": "agentEdit",
                          "attrs": {
                            "by": "claude:a16e40ca-fbee-46c2-9e61-388e4b23cb4e"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
