<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- AIB's .deb self-update: `/usr/bin/pkexec /usr/lib/aib/aib-install-deb <file>` asks for an administrator password with this
     message, only in the active local session (no prompt over SSH or in an inactive session), every time (auth_admin, not _keep:
     no five-minute window in which another program could run it again without a prompt). -->
<policyconfig>
  <vendor>AIB</vendor>
  <vendor_url>https://github.com/sirkuttin/AIB</vendor_url>
  <action id="dev.aib.app.update">
    <description>Update AIB</description>
    <message>Authentication is required to update AIB</message>
    <icon_name>aib</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aib/aib-install-deb</annotate>
  </action>
</policyconfig>
